# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
# ⚠️ ห้าม commit ไฟล์ .env ลง git

# ── ฝั่งเว็บ (ปลอดภัยที่จะอยู่ใน bundle) ──────────────────────
# Supabase Dashboard → Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=https://sntxojhhtxfrwprmhrhy.supabase.co
VITE_SUPABASE_ANON_KEY=

# รหัสเข้าใช้งาน (เช็คฝั่ง client — ดูหมายเหตุใน 0002_rls.sql)
VITE_APP_PASSCODE=

# ลิงก์ Google Sheet ที่ใช้แก้ตำแหน่ง (ดู sheet/README.md)
# ใส่ค่า = ปิดปุ่มแก้ตำแหน่งในเว็บและ PDA ให้แก้ที่ชีตที่เดียว
# ปล่อยว่าง = แก้ในเว็บแบบเดิม
# ⚠️ ต้องตั้งใน Vercel → Settings → Environment Variables ด้วย แล้ว redeploy
VITE_LOCATION_SHEET_URL=

# ── ฝั่งสคริปต์เท่านั้น ────────────────────────────────────────
# ⚠️ service_role key ข้ามผ่าน RLS ทั้งหมด
#    ใช้เฉพาะ scripts/import-catalog.mjs บนเครื่องเท่านั้น
#    ห้ามขึ้นต้นด้วย VITE_ เพราะ Vite จะฝังลง bundle ให้ทุกคนเห็น
SUPABASE_SERVICE_KEY=
